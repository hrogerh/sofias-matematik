{
  "title": "Ekvationer",
  "doneSection": "03-ekvationer-bada-sidor",
  "doneText": "Fortsätt →",
  "steps": [
    {
      "type": "theory",
      "text": "En ekvation har ett <strong>likhetstecken</strong>. Båda sidor ska vara lika. Vi hittar vilket tal variabeln måste vara för att det ska stämma.",
      "example": "\\( x + 4 = 10 \\)\n\nTa bort 4 från båda sidor:\n\\( x = 10 - 4 = 6 \\)"
    },
    {
      "type": "exercise",
      "q": "Lös ekvationen: \\( x + 7 = 15 \\)",
      "answer": "8",
      "ok": "Rätt! \\( 8 + 7 = 15 \\) stämmer.",
      "retry": "Vad måste \\( x \\) vara för att summan ska bli 15?",
      "hint": "\\( x = 15 - 7 \\)"
    },
    {
      "type": "theory",
      "text": "Om variabeln är multiplicerad med ett tal, delar vi båda sidor med det talet.",
      "example": "\\( 3x = 12 \\)\n\nDela båda sidor med 3:\n\\( x = 12 \\div 3 = 4 \\)"
    },
    {
      "type": "exercise",
      "q": "Lös: \\( 2x = 14 \\)",
      "answer": "7",
      "ok": "Rätt! \\( 2 \\cdot 7 = 14 \\).",
      "retry": "Dela båda sidor med 2.",
      "hint": "\\( x = 14 \\div 2 \\)"
    },
    {
      "type": "exercise",
      "q": "Lös: \\( 5x = 35 \\)",
      "answer": "7",
      "ok": "Perfekt! \\( 5 \\cdot 7 = 35 \\).",
      "retry": "Dela båda sidor med 5.",
      "hint": "\\( x = 35 \\div 5 \\)"
    },
    {
      "type": "theory",
      "text": "Om det finns ett tal på samma sida som \\( x \\), flyttar vi det till andra sidan. Addition blir subtraktion – och tvärtom.",
      "example": "\\( 2x + 3 = 11 \\)\n\nFlytta 3: &nbsp;\\( 2x = 11 - 3 = 8 \\)\nDela med 2: &nbsp;\\( x = 4 \\)"
    },
    {
      "type": "exercise",
      "q": "Lös: \\( 3x + 2 = 14 \\)",
      "answer": "4",
      "ok": "Rätt! \\( 3x = 12 \\) och \\( x = 4 \\).",
      "retry": "Flytta 2 till höger sidan först.",
      "hint": "\\( 3x = 14 - 2 = 12 \\), sedan \\( x = 12 \\div 3 \\)"
    }
  ]
}
